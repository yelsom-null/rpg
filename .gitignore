# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packages lock file (regenerated by the editor)
/Packages/packages-lock.json

# MCP for Unity local state
/Library/mcp-for-unity*
.mcp-for-unity/

# Local-only third-party asset packs: imported per-machine, NOT committed to the
# shared repo (keeps clones small and sidesteps the file-size limits). Drop big
# packs like the Quaternius Medieval Village MegaKit here; assign their prefabs
# to the ElderholtAssets override slots. See Assets/Elderholt/README.md.
# (The explicit *.meta line re-ignores metas the global !*.meta rule un-ignores.)
/Assets/ThirdPartyLocal/
/Assets/ThirdPartyLocal.meta
/Assets/ThirdPartyLocal/**/*.meta
